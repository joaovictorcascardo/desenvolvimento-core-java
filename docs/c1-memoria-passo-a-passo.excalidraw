      "updated": 1793145321696,
      "link": null,
      "locked": false,
      "text": "public class Contador {\n    static int total = 0; // placar\n\n    static void contar() {\n        int local = 0;    // na folha\n        local++;\n        total++;\n    }\n\n    public static void main(String[] a) {\n        contar();\n        contar();\n    }\n}",
      "originalText": "public class Contador {\n    static int total = 0; // placar\n\n    static void contar() {\n        int local = 0;    // na folha\n        local++;\n        total++;\n    }\n\n    public static void main(String[] a) {\n        contar();\n        contar();\n    }\n}",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
