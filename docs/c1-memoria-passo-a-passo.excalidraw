      "text": "public class Cliente {\n    String nome;      // 1 por OBJETO\n    static int total; // 1 só, da CLASSE\n\n    Cliente() {       // roda a cada new\n        total++;\n    }\n}",
      "originalText": "public class Cliente {\n    String nome;      // 1 por OBJETO\n    static int total; // 1 só, da CLASSE\n\n    Cliente() {       // roda a cada new\n        total++;\n    }\n}",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
