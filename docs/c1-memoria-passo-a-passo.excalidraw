      "updated": 1793145321696,
      "link": null,
      "locked": false,
      "text": "static int fatorial(int n) {\n    if (n == 0) return 1;\n    return n * fatorial(n - 1);\n}\n\nfatorial(3);   // no main",
      "originalText": "static int fatorial(int n) {\n    if (n == 0) return 1;\n    return n * fatorial(n - 1);\n}\n\nfatorial(3);   // no main",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "p351_9648y7",
